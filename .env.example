# WhatsApp business number (E.164 without +), used by the floating chat widget
NEXT_PUBLIC_WHATSAPP_NUMBER=919811553264

# Site URL, used for sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.nayraluxe.com

# Supabase — create a project at https://supabase.com, then run
# supabase/schema.sql in its SQL editor. Find these under
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose with a NEXT_PUBLIC_ prefix. Used by API routes
# (e.g. /api/upload) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

